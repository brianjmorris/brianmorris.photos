{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "brianmorris-photos",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-11-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
  },
}
