---
import { env } from 'cloudflare:workers';
import BaseLayout from '../../layouts/BaseLayout.astro';

if (!Astro.locals.owner)
  return new Response('Sign-in required.', { status: 403 });
---

<BaseLayout title="Dashboard" description="Private photography dashboard.">
  <h1>Dashboard</h1>
  <nav aria-label="Dashboard">
    <a href="/dashboard/tags">Tags</a>
    <a href="/dashboard/collections">Collections</a>
    <a href="/dashboard/photos">Photograph review</a>
    {env.CATALOGUE && env.DRAFT_PHOTOS && (
      <a href="/dashboard/storage">Draft photo storage</a>
    )}
  </nav>
  <p>
    You’re signed in. Your photo and collection tools will appear here as
    they’re added.
  </p>
</BaseLayout>
