{
  "name": "brianmorris-photos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.0.0 <12"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "build": "astro build",
    "test": "node --test tests/catalogue.test.mjs",
    "verify": "npm run format:check && npm run check && npm test && npm run build",
    "deploy": "wrangler deploy --config dist/server/wrangler.json",
    "deploy:check": "wrangler deploy --config dist/server/wrangler.json --dry-run",
    "preview": "astro preview --host 127.0.0.1",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.8",
    "@astrojs/react": "7.1.9",
    "astro": "7.4.12",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "miniflare": "5.20261110.0-beta",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3",
    "wrangler": "4.163.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261110.1": true,
    "workerd@1.20261116.1": true
  }
}
